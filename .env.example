# Server configuration
PORT=8080
LOG_LEVEL=INFO

# Set to "production" to disable dev logging middleware
ENV=development

# Required: RapidAPI key for Real-Time Amazon Data API
# Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-amazon-data
# Free tier: 100 requests/month, no card required
RAPIDAPI_KEY=your-rapidapi-key-here

# Optional: override the RapidAPI host (default: real-time-amazon-data.p.rapidapi.com)
# RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com
